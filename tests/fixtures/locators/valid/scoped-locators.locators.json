{
  "$schema": "https://schemas.skeletonkey.dev/locators/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "contacts",
  "locators": {
    "contactForm": {
      "strategies": [
        { "kind": "role", "role": "form", "name": "Contact", "match": "exact", "caseSensitive": true }
      ]
    },
    "saveButton": {
      "within": "contactForm",
      "strategies": [
        { "kind": "role", "role": "button", "name": "Save", "match": "exact", "caseSensitive": true }
      ]
    }
  }
}
