{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "unreachable-node",
  "name": "Unreachable Node",
  "nodes": [
    {
      "id": "start",
      "type": "core.start",
      "typeVersion": 1
    },
    {
      "id": "reachable",
      "type": "core.log",
      "typeVersion": 1
    },
    {
      "id": "unreachable",
      "type": "core.log",
      "typeVersion": 1
    }
  ],
  "connections": [
    {
      "from": {
        "node": "start",
        "port": "main"
      },
      "to": {
        "node": "reachable",
        "port": "main"
      }
    }
  ]
}
