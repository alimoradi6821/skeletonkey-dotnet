{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "expression-self-reference",
  "name": "expression-self-reference",
  "inputs": {},
  "variables": {},
  "nodes": [
    {
      "id": "start",
      "type": "core.start",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {}
    },
    {
      "id": "branch",
      "type": "flow.if",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {
        "condition": {
          "$expression": "nodes['branch'].outputs.result"
        }
      }
    },
    {
      "id": "end",
      "type": "core.end",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {}
    }
  ],
  "connections": [
    {
      "from": {
        "node": "start",
        "port": "main"
      },
      "to": {
        "node": "branch",
        "port": "main"
      }
    },
    {
      "from": {
        "node": "branch",
        "port": "true"
      },
      "to": {
        "node": "end",
        "port": "main"
      }
    }
  ],
  "outputs": {}
}
