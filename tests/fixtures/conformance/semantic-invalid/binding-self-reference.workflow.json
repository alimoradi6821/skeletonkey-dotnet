    { "id": "start", "type": "core.start", "typeVersion": 1, "disabled": false, "parameters": {} },
    { "id": "invoke", "type": "workflow.invoke", "typeVersion": 1, "disabled": false, "parameters": { "workflow": { "id": "child-workflow" }, "inputs": { "result": { "$binding": { "source": "node", "node": "invoke", "port": "result" } } } } }
