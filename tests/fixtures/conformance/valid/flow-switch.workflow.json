{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "flow-switch",
  "name": "flow-switch",
  "inputs": {
    "enabled": {
      "type": "boolean"
    },
    "items": {
      "type": "array"
    },
    "method": {
      "type": "string"
    },
    "count": {
      "type": "integer"
    },
    "account": {
      "type": "object"
    }
  },
  "variables": {},
  "nodes": [
    {
      "id": "start",
      "type": "core.start",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {}
    },
    {
      "id": "select",
      "type": "flow.switch",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {
        "cases": [
          {
            "id": "phone",
            "when": {
              "$expression": "inputs.method == 'phone'"
            }
          },
          {
            "id": "username",
            "when": false
          }
        ]
      }
    },
    {
      "id": "end",
      "type": "core.end",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {}
    }
  ],
  "connections": [
    {
      "from": {
        "node": "start",
        "port": "main"
      },
      "to": {
        "node": "select",
        "port": "main"
      }
    },
    {
      "from": {
        "node": "select",
        "port": "phone"
      },
      "to": {
        "node": "end",
        "port": "main"
      }
    }
  ],
  "outputs": {}
}
