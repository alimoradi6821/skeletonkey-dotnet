{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "workflow-resources",
  "name": "Workflow Resources",
  "resources": {
    "browser": {
      "kind": "web.browser",
      "lifetime": "execution",
      "access": "exclusive",
      "required": true,
      "capabilities": [
        "web.persistent-profile"
      ],
      "constraints": {
        "engine": "chromium",
        "profile": "persistent",
        "visibility": "headful"
      }
    }
  },
  "nodes": [
    { "id": "start", "type": "core.start", "typeVersion": 1 }
  ],
  "connections": []
}
