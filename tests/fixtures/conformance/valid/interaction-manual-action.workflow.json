{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "interaction-manual-action",
  "name": "Interaction Manual Action",
  "nodes": [
    { "id": "start", "type": "core.start", "typeVersion": 1 },
    { "id": "request", "type": "interaction.request", "typeVersion": 1, "parameters": { "kind": "manual-action", "prompt": "Log into the displayed account, then confirm completion.", "required": true, "timeout": "PT5M" } }
  ],
  "connections": [
    { "from": { "node": "start", "port": "main" }, "to": { "node": "request", "port": "main" } }
  ]
}
