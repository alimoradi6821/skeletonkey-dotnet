{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "flow-while",
  "name": "flow-while",
  "inputs": {
    "enabled": {
      "type": "boolean"
    },
    "items": {
      "type": "array"
    },
    "method": {
      "type": "string"
    },
    "count": {
      "type": "integer"
    },
    "account": {
      "type": "object"
    }
  },
  "variables": {},
  "nodes": [
    {
      "id": "start",
      "type": "core.start",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {}
    },
    {
      "id": "loop",
      "type": "flow.while",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {
        "condition": {
          "$expression": "inputs.enabled"
        },
        "maxIterations": 10
      }
    },
    {
      "id": "end",
      "type": "core.end",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {}
    }
  ],
  "connections": [
    {
      "from": {
        "node": "start",
        "port": "main"
      },
      "to": {
        "node": "loop",
        "port": "main"
      }
    },
    {
      "from": {
        "node": "loop",
        "port": "completed"
      },
      "to": {
        "node": "end",
        "port": "main"
      }
    }
  ],
  "outputs": {}
}
