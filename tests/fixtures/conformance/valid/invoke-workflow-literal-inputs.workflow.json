{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "invoke-literal-inputs",
  "name": "Invoke literal inputs",
  "inputs": {},
  "variables": {},
  "nodes": [
    { "id": "start", "type": "core.start", "typeVersion": 1, "disabled": false, "parameters": {} },
    {
      "id": "invoke",
      "type": "workflow.invoke",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {
        "workflow": { "id": "child-workflow", "version": "1.0.0" },
        "inputs": { "message": "hello", "count": 1, "enabled": true },
        "streams": { "mode": "forward" }
      }
    }
  ],
  "connections": [
    { "from": { "node": "start", "port": "main" }, "to": { "node": "invoke", "port": "main" } }
  ],
  "outputs": {}
}
