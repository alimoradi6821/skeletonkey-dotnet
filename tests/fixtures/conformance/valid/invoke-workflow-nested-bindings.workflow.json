{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "invoke-nested-bindings",
  "name": "Invoke nested bindings",
  "inputs": { "account": { "type": "object", "required": false } },
  "variables": { "message": "hello" },
  "nodes": [
    { "id": "start", "type": "core.start", "typeVersion": 1, "disabled": false, "parameters": {} },
    {
      "id": "invoke",
      "type": "workflow.invoke",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {
        "workflow": { "id": "child-workflow", "version": "1.0.0" },
        "inputs": {
          "payload": {
            "accountId": { "$binding": { "source": "input", "name": "account", "path": "/id" } },
            "message": { "$binding": { "source": "variable", "name": "message" } }
          }
        }
      }
    }
  ],
  "connections": [
    { "from": { "node": "start", "port": "main" }, "to": { "node": "invoke", "port": "main" } }
  ],
  "outputs": {}
}
