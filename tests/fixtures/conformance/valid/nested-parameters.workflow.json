{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "valid-nested-parameters",
  "name": "Valid Nested Parameters",
  "nodes": [
    {
      "id": "start",
      "type": "core.start",
      "typeVersion": 1
    },
    {
      "id": "log",
      "type": "core.log",
      "typeVersion": 1,
      "parameters": {
        "message": "hello",
        "count": 12,
        "ratio": 1.25,
        "enabled": true,
        "nothing": null,
        "nested": {
          "items": [
            "one",
            2,
            false,
            null
          ]
        }
      }
    },
    {
      "id": "end",
      "type": "core.end",
      "typeVersion": 1
    }
  ],
  "connections": [
    {
      "from": {
        "node": "start",
        "port": "main"
      },
      "to": {
        "node": "log",
        "port": "main"
      }
    },
    {
      "from": {
        "node": "log",
        "port": "main"
      },
      "to": {
        "node": "end",
        "port": "main"
      }
    }
  ]
}
