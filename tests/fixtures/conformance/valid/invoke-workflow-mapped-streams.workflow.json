{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "invoke-mapped-streams",
  "name": "Invoke mapped streams",
  "inputs": {},
  "variables": {},
  "nodes": [
    { "id": "start", "type": "core.start", "typeVersion": 1, "disabled": false, "parameters": {} },
    { "id": "invoke", "type": "workflow.invoke", "typeVersion": 1, "disabled": false, "parameters": { "workflow": { "id": "child-workflow", "version": "1.0.0" }, "streams": { "mode": "map", "mappings": { "child.results": "parent.results" } } } }
  ],
  "connections": [
    { "from": { "node": "start", "port": "main" }, "to": { "node": "invoke", "port": "main" } }
  ],
  "outputs": {
    "parentEvents": { "mode": "stream", "channel": "parent.results" }
  }
}
