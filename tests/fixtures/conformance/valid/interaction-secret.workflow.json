{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "interaction-secret",
  "name": "Interaction Secret",
  "nodes": [
    { "id": "start", "type": "core.start", "typeVersion": 1 },
    { "id": "request", "type": "interaction.request", "typeVersion": 1, "parameters": { "kind": "secret", "prompt": "Enter the one-time code.", "required": true, "timeout": "PT2M" } }
  ],
  "connections": [
    { "from": { "node": "start", "port": "main" }, "to": { "node": "request", "port": "main" } }
  ]
}
