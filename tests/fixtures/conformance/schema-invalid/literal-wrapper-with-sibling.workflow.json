{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "literal-wrapper-with-sibling",
  "name": "Literal wrapper with sibling",
  "nodes": [
    {
      "id": "invoke",
      "type": "workflow.invoke",
      "typeVersion": 1,
      "parameters": {
        "workflow": { "id": "child-workflow" },
        "inputs": {
          "value": {
            "$literal": { "$binding": "literal" },
            "sibling": true
          }
        }
      }
    }
  ],
  "connections": []
}
