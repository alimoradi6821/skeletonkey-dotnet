{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "resource-wrapper-with-sibling",
  "name": "Resource Wrapper With Sibling",
  "nodes": [
    { "id": "start", "type": "core.start", "typeVersion": 1 },
    { "id": "invoke", "type": "workflow.invoke", "typeVersion": 1, "parameters": { "workflow": { "id": "child-workflow" }, "inputs": { "resource": { "$resource": { "name": "browser" }, "extra": true } } } }
  ],
  "connections": [
    { "from": { "node": "start", "port": "main" }, "to": { "node": "invoke", "port": "main" } }
  ]
}
