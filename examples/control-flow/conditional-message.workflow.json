{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "conditional-message",
  "name": "Conditional Message",
  "inputs": {
    "recipient": {
      "type": "object",
      "required": true
    }
  },
  "variables": {},
  "resources": {},
  "nodes": [
    {
      "id": "start",
      "type": "core.start",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {}
    },
    {
      "id": "has-recipient-name",
      "type": "flow.if",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {
        "condition": {
          "$expression": "size(trim(inputs.recipient.name)) \u003E 0"
        }
      }
    },
    {
      "id": "end",
      "type": "core.end",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {}
    }
  ],
  "connections": [
    {
      "from": {
        "node": "start",
        "port": "main"
      },
      "to": {
        "node": "has-recipient-name",
        "port": "main"
      }
    },
    {
      "from": {
        "node": "has-recipient-name",
        "port": "true"
      },
      "to": {
        "node": "end",
        "port": "main"
      }
    },
    {
      "from": {
        "node": "has-recipient-name",
        "port": "false"
      },
      "to": {
        "node": "end",
        "port": "main"
      }
    }
  ],
  "outputs": {}
}
