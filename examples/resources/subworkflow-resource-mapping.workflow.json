{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "subworkflow-resource-mapping",
  "name": "Subworkflow Resource Mapping",
  "inputs": {},
  "variables": {},
  "resources": {
    "browser": {
      "kind": "web.browser",
      "lifetime": "execution",
      "access": "exclusive",
      "required": true,
      "capabilities": [],
      "description": "Parent browser requirement explicitly mapped to the child workflow."
    }
  },
  "nodes": [
    {
      "id": "start",
      "type": "core.start",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {}
    },
    {
      "id": "invoke-child",
      "type": "workflow.invoke",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {
        "workflow": {
          "id": "child-workflow"
        },
        "resources": {
          "browser": {
            "$resource": {
              "name": "browser"
            }
          }
        }
      }
    }
  ],
  "connections": [
    {
      "from": {
        "node": "start",
        "port": "main"
      },
      "to": {
        "node": "invoke-child",
        "port": "main"
      }
    }
  ],
  "outputs": {}
}
