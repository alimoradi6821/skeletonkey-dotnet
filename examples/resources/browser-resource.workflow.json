{
  "$schema": "https://schemas.skeletonkey.dev/workflow/0.1/schema.json",
  "specVersion": "0.1.0",
  "id": "browser-resource",
  "name": "Browser Resource",
  "inputs": {},
  "variables": {},
  "resources": {
    "browser": {
      "kind": "web.browser",
      "lifetime": "execution",
      "access": "exclusive",
      "required": true,
      "capabilities": [
        "web.persistent-profile",
        "web.headful"
