      "constraints": {
        "engine": "chromium",
        "profile": "persistent",
        "visibility": "headful"
      },
      "description": "A host-provided browser resource requirement."
    }
  },
  "nodes": [
    {
      "id": "start",
      "type": "core.start",
      "typeVersion": 1,
      "disabled": false,
      "parameters": {}
    }
  ],
  "connections": [],
  "outputs": {}
}
