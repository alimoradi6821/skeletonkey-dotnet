<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SkeletonKey.Standalone.Host</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SkeletonKey.Desktop.FlaUI\SkeletonKey.Desktop.FlaUI.csproj" />
    <ProjectReference Include="..\..\src\SkeletonKey.Runner.Core\SkeletonKey.Runner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(StandaloneWorkflowPath)" LogicalName="SkeletonKey.Standalone.workflow.json" Condition="'$(StandaloneWorkflowPath)' != '' and Exists('$(StandaloneWorkflowPath)')" />
    <EmbeddedResource Include="$(StandaloneSettingsPath)" LogicalName="SkeletonKey.Standalone.execution.settings.json" Condition="'$(StandaloneSettingsPath)' != '' and Exists('$(StandaloneSettingsPath)')" />
    <EmbeddedResource Include="$(StandalonePackageManifestPath)" LogicalName="SkeletonKey.Standalone.package.manifest.json" Condition="'$(StandalonePackageManifestPath)' != '' and Exists('$(StandalonePackageManifestPath)')" />
    <EmbeddedResource Include="$(StandaloneLocatorDirectory)\*.locators.json" LogicalName="SkeletonKey.Standalone.Locators.%(Filename)%(Extension)" Condition="'$(StandaloneLocatorDirectory)' != '' and Exists('$(StandaloneLocatorDirectory)')" />
    <EmbeddedResource Include="$(StandaloneWorkflowDirectory)\*.workflow.json" LogicalName="SkeletonKey.Standalone.Workflows.%(Filename)%(Extension)" Condition="'$(StandaloneWorkflowDirectory)' != '' and Exists('$(StandaloneWorkflowDirectory)')" />
  </ItemGroup>

  <Target Name="ValidateStandaloneEmbeddedInputs" BeforeTargets="BeforeBuild">
    <Error Condition="'$(StandaloneWorkflowPath)' == '' or !Exists('$(StandaloneWorkflowPath)')" Text="StandaloneWorkflowPath must point to an existing workflow snapshot." />
    <Error Condition="'$(StandaloneSettingsPath)' == '' or !Exists('$(StandaloneSettingsPath)')" Text="StandaloneSettingsPath must point to an existing settings snapshot." />
    <Error Condition="'$(StandalonePackageManifestPath)' == '' or !Exists('$(StandalonePackageManifestPath)')" Text="StandalonePackageManifestPath must point to an existing package manifest." />
  </Target>
</Project>
